    {
      "index": 28,
      "text": "[jeda:32]",
      "file": "c028.ogg",
      "durationSec": 4.2
    },
    {
      "index": 29,
      "text": "Paha. Lutut. Betis. Pergelangan kaki. Kaki. Jari kaki.",
