    {
      "index": 18,
      "text": "[jeda:27]",
      "file": "c018.ogg",
      "durationSec": 4.176
    },
    {
      "index": 19,
      "text": "Tenggorokan. Leher. Bahu.",
      "file": "c019.ogg",
      "durationSec": 8.592
    },
    {
      "index": 20,
      "text": "Undang bahu untuk turun.",
