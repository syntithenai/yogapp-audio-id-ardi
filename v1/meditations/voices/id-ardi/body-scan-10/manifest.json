      "text": "[jeda:32]",
      "file": "c038.ogg",
      "durationSec": 4.2
    },
    {
      "index": 39,
      "text": "Mulai dalamkan pernapasan.",
      "file": "c039.ogg",
      "durationSec": 4.344
    },
    {
      "index": 40,
      "text": "Rasakan ruangan lagi.",
      "file": "c040.ogg",
      "durationSec": 3.984
    },
    {
