      "durationSec": 14.016
    },
    {
      "index": 23,
      "text": "[jeda:32]",
      "file": "c023.ogg",
      "durationSec": 4.2
    },
    {
      "index": 24,
      "text": "Dada naik turun.",
      "file": "c024.ogg",
      "durationSec": 3.504
    },
    {
      "index": 25,
      "text": "Ruang jantung melunak.",
      "file": "c025.ogg",
