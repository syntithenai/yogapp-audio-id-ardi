    },
    {
      "index": 21,
      "text": "[jeda:32]",
      "file": "c021.ogg",
      "durationSec": 4.2
    },
    {
      "index": 22,
      "text": "Lengan. Siku. Pergelangan tangan. Tangan. Jari.",
