      "file": "c012.ogg",
      "durationSec": 4.32
    },
    {
      "index": 13,
      "text": "Pemaafan di sini berarti melepaskan kepalan tangan yang kaku.",
      "file": "c013.ogg",
      "durationSec": 6.864
    },
    {
      "index": 14,
      "text": "Bukan berpura-pura bahwa luka tidak penting.",
