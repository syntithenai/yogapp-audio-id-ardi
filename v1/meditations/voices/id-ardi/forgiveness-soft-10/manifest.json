    {
      "index": 18,
      "text": "[jeda:34]",
      "file": "c018.ogg",
      "durationSec": 4.32
    },
    {
      "index": 19,
      "text": "Secara diam-diam: Saya memaafkan diri saya karena menjadi manusia.",
      "file": "c019.ogg",
      "durationSec": 8.28
    },
    {
      "index": 20,
      "text": "Saya melepaskan apa yang tidak lagi perlu saya bawa.",
