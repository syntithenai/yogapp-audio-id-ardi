      "durationSec": 6.072
    },
    {
      "index": 21,
      "text": "[jeda:54]",
      "file": "c021.ogg",
      "durationSec": 4.248
    },
    {
      "index": 22,
      "text": "Jika terasa tepat, bayangkan sebuah kesulitan kecil dengan orang lain.",
      "file": "c022.ogg",
      "durationSec": 8.136
    },
    {
      "index": 23,
      "text": "Bukan cerita yang paling sulit. Yang lebih ringan.",
