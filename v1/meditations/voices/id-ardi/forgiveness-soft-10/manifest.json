    },
    {
      "index": 24,
      "text": "[jeda:34]",
      "file": "c024.ogg",
      "durationSec": 4.32
    },
    {
      "index": 25,
      "text": "Saya melepaskan apa yang bisa saya lepaskan.",
      "file": "c025.ogg",
      "durationSec": 5.664
    },
    {
      "index": 26,
      "text": "Saya menjaga batas saya. Saya meletakkan beban berlebih.",
      "file": "c026.ogg",
      "durationSec": 8.784
    },
    {
      "index": 27,
      "text": "[jeda:54]",
      "file": "c027.ogg",
      "durationSec": 4.248
    },
    {
      "index": 28,
      "text": "Tarik napas ke tempat yang menegang.",
