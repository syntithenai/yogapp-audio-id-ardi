    {
      "index": 15,
      "text": "[jeda:34]",
      "file": "c015.ogg",
      "durationSec": 4.32
    },
    {
      "index": 16,
      "text": "Mulailah dengan sesuatu yang kecil yang kamu simpan terhadap dirimu sendiri.",
      "file": "c016.ogg",
      "durationSec": 7.728
    },
    {
      "index": 17,
      "text": "Kesalahan. Kelemahan.",
