    },
    {
      "index": 14,
      "text": "Yang tersisa bisa menunggu sampai pagi.",
      "file": "c014.ogg",
      "durationSec": 5.16
    },
    {
      "index": 15,
      "text": "Rasakan kasur atau lantai menopang Anda.",
      "file": "c015.ogg",
      "durationSec": 5.424
    },
    {
      "index": 16,
      "text": "Nafas lebih tenang. Tubuh lebih berat.",
