    },
    {
      "index": 6,
      "text": "Buang napas selama enam hitungan.",
      "file": "c006.ogg",
      "durationSec": 4.656
    },
    {
      "index": 7,
      "text": "Lagi. Empat masuk. Enam keluar.",
      "file": "c007.ogg",
      "durationSec": 9.0
    },
    {
      "index": 8,
      "text": "Buang napas yang lebih panjang memberi tahu tubuh bahwa aman untuk beristirahat.",
      "file": "c008.ogg",
      "durationSec": 7.92
    },
    {
      "index": 9,
      "text": "Periksa ketegangan yang tersisa di wajah.",
