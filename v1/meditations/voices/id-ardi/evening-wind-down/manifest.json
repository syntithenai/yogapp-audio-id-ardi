      "file": "c002.ogg",
      "durationSec": 5.28
    },
    {
      "index": 3,
      "text": "Biarkan hari ini berakhir, meskipun pikiran masih memikirkan tugas.",
      "file": "c003.ogg",
      "durationSec": 8.04
    },
    {
      "index": 4,
      "text": "Anda bisa menaruhnya untuk saat ini.",
      "file": "c004.ogg",
