    },
    {
      "index": 22,
      "text": "[jeda:44]",
      "file": "c022.ogg",
      "durationSec": 4.32
    },
    {
      "index": 23,
      "text": "Tarik napas sederhana itu masuk.",
      "file": "c023.ogg",
