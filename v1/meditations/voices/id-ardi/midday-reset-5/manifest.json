      "durationSec": 3.912
    },
    {
      "index": 19,
      "text": "[jeda:30]",
      "file": "c019.ogg",
      "durationSec": 3.912
    },
    {
      "index": 20,
      "text": "Tanyakan secara pelan: apa yang penting dalam satu jam ke depan?",
      "file": "c020.ogg",
      "durationSec": 7.08
    },
    {
      "index": 21,
      "text": "Satu langkah selanjutnya yang jelas sudah cukup.",
