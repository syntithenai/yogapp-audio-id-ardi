    },
    {
      "index": 3,
      "text": "Lemaskan mata, atau tutuplah.",
      "file": "c003.ogg",
      "durationSec": 5.472
    },
    {
      "index": 4,
      "text": "Tarik napas perlahan.",
      "file": "c004.ogg",
      "durationSec": 3.864
    },
    {
      "index": 5,
      "text": "Dan hembuskan napas lebih lama.",
      "file": "c005.ogg",
      "durationSec": 4.536
    },
    {
      "index": 6,
      "text": "Biarkan pagi berakhir di sini, meskipun hari masih berlanjut.",
      "file": "c006.ogg",
      "durationSec": 7.656
    },
    {
      "index": 7,
      "text": "Turunkan bahu.",
      "file": "c007.ogg",
      "durationSec": 3.36
    },
    {
      "index": 8,
      "text": "Lepaskan rahang.",
      "file": "c008.ogg",
