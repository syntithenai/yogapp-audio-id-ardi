    {
      "index": 13,
      "text": "[jeda:30]",
      "file": "c013.ogg",
      "durationSec": 3.912
    },
    {
      "index": 14,
      "text": "Bayangkan meletakkan apa pun yang sedang kamu bawa.",
      "file": "c014.ogg",
      "durationSec": 5.712
    },
    {
      "index": 15,
      "text": "Itu bisa menunggu di meja di sampingmu.",
      "file": "c015.ogg",
      "durationSec": 5.16
    },
    {
      "index": 16,
      "text": "[jeda:37]",
      "file": "c016.ogg",
      "durationSec": 4.368
    },
    {
      "index": 17,
      "text": "Rasakan tulang belakang tegak.",
      "file": "c017.ogg",
      "durationSec": 4.392
    },
    {
      "index": 18,
      "text": "Rasakan perut lembut.",
