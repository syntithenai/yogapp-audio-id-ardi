    },
    {
      "index": 9,
      "text": "[jeda:30]",
      "file": "c009.ogg",
      "durationSec": 3.912
    },
    {
      "index": 10,
      "text": "Tarik napas melalui hidung.",
      "file": "c010.ogg",
      "durationSec": 4.296
    },
    {
      "index": 11,
      "text": "Hembuskan napas melalui mulut, seolah-olah mengaburkan kaca.",
      "file": "c011.ogg",
      "durationSec": 7.464
    },
    {
      "index": 12,
      "text": "Lagi.",
