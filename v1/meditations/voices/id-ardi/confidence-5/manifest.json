    },
    {
      "index": 11,
      "text": "[jeda:22]",
      "file": "c011.ogg",
      "durationSec": 4.104
    },
    {
      "index": 12,
      "text": "Coba ucapkan kalimat-kalimat ini secara diam-diam, atau hanya dengarkan.",
      "file": "c012.ogg",
      "durationSec": 8.616
    },
    {
      "index": 13,
      "text": "Saya bisa menghadapi apa yang harus saya hadapi.",
      "file": "c013.ogg",
      "durationSec": 5.784
    },
    {
      "index": 14,
      "text": "[jeda:22]",
      "file": "c014.ogg",
      "durationSec": 4.104
    },
    {
      "index": 15,
      "text": "Saya tidak perlu terburu-buru dalam menjadi.",
      "file": "c015.ogg",
      "durationSec": 5.496
    },
    {
      "index": 16,
      "text": "[jeda:22]",
      "file": "c016.ogg",
      "durationSec": 4.104
    },
    {
      "index": 17,
      "text": "Saya percaya pada langkah jujur saya berikutnya.",
      "file": "c017.ogg",
      "durationSec": 5.784
    },
    {
      "index": 18,
      "text": "[jeda:28]",
      "file": "c018.ogg",
      "durationSec": 4.272
    },
    {
      "index": 19,
      "text": "Bernapaslah dengan keyakinan sebagai kehangatan di dada, bukan sebagai perisai.",
      "file": "c019.ogg",
      "durationSec": 9.024
    },
    {
      "index": 20,
      "text": "[jeda:28]",
      "file": "c020.ogg",
      "durationSec": 4.272
    },
    {
      "index": 21,
      "text": "Bayangkan diri Anda menghadapi satu tantangan biasa dengan ketenangan.",
      "file": "c021.ogg",
      "durationSec": 7.488
    },
    {
      "index": 22,
      "text": "[jeda:33]",
      "file": "c022.ogg",
      "durationSec": 4.32
    },
    {
      "index": 23,
      "text": "Kembali ke pernapasan.",
